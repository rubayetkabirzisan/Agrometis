<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    prefWidth="1200.0" prefHeight="760.0"
    styleClass="app-root"
    stylesheets="@../styles/application.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.rubaet.agrihub.ui.history.YieldHistoryController">

    <!-- ── TOP BAR ── -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Back" styleClass="btn-ghost" onAction="#goHome" mnemonicParsing="false" />
            <Label text="📊" style="-fx-font-size: 20px;" />
            <VBox spacing="2">
                <Label text="Yield History" styleClass="text-page-title" />
                <Label text="Track and visualize your harvest performance over time." styleClass="text-muted" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="summaryLabel" text="" styleClass="badge-success" />
        </HBox>
    </top>

    <!-- ── CENTER ── -->
    <center>
        <ScrollPane styleClass="scroll-area" fitToWidth="true" fitToHeight="true">
            <HBox spacing="0">

                <!-- LEFT: Record Harvest Form -->
                <VBox spacing="20"
                      style="-fx-padding: 24; -fx-pref-width: 360; -fx-min-width: 300;
                             -fx-background-color: #0d1117; -fx-border-color: transparent #30363d transparent transparent;
                             -fx-border-width: 0 1 0 0;">

                    <Label text="Record Harvest" styleClass="text-section" />

                    <VBox spacing="6">
                        <Label text="Crop Name *" styleClass="text-muted" />
                        <TextField fx:id="cropField" styleClass="field-input" promptText="e.g. Rice" />
                    </VBox>
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Season" styleClass="text-muted" />
                            <TextField fx:id="seasonField" styleClass="field-input" promptText="e.g. Kharif" />
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Year *" styleClass="text-muted" />
                            <TextField fx:id="yearField" styleClass="field-input" promptText="2026" />
                        </VBox>
                    </HBox>
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Yield (kg) *" styleClass="text-muted" />
                            <TextField fx:id="yieldField" styleClass="field-input" promptText="e.g. 5000" />
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Revenue ($)" styleClass="text-muted" />
                            <TextField fx:id="revenueField" styleClass="field-input" promptText="e.g. 1200" />
                        </VBox>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="Notes" styleClass="text-muted" />
                        <TextArea fx:id="notesField" styleClass="chat-area" prefRowCount="2" promptText="Optional..." />
                    </VBox>
                    <Button fx:id="recordBtn" text="📊  Record Harvest" styleClass="btn-primary"
                            onAction="#recordHarvest" maxWidth="Infinity" mnemonicParsing="false" />
                    <Label fx:id="statusLabel" text="" styleClass="text-success" />

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Record list -->
                    <Label text="Recent Records" styleClass="text-section" />
                    <VBox fx:id="recordListBox" spacing="0">
                        <Label text="Loading..." styleClass="text-muted" />
                    </VBox>
                </VBox>

                <!-- RIGHT: Chart -->
                <VBox spacing="20" style="-fx-padding: 28;" HBox.hgrow="ALWAYS">
                    <LineChart fx:id="yieldChart" styleClass="agri-chart" VBox.vgrow="ALWAYS"
                               animated="true" title="Yield Trend Over Years">
                        <xAxis><CategoryAxis label="Year" /></xAxis>
                        <yAxis><NumberAxis label="Yield (kg)" /></yAxis>
                    </LineChart>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
