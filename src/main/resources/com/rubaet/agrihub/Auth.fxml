<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Auth.fxml — Login & Registration Screen (Split-Panel Layout)
  Controller: com.rubaet.agrihub.ui.auth.AuthController
-->
<HBox
    prefWidth="1100.0"
    prefHeight="700.0"
    styleClass="app-root"
    stylesheets="@styles/application.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.rubaet.agrihub.ui.auth.AuthController">

    <!-- ── LEFT PANEL: Branding ── -->
    <VBox
        alignment="CENTER"
        spacing="24"
        style="-fx-background-color: linear-gradient(to bottom, #0a1a12, #0d2419, #0d1117); -fx-padding: 60 48 60 48; -fx-pref-width: 440; -fx-min-width: 380;"
        HBox.hgrow="NEVER">

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="12">
            <Label text="🌿" style="-fx-font-size: 64px; -fx-effect: dropshadow(gaussian, rgba(34,197,94,0.6), 20, 0.4, 0, 0);" />
            <Label text="Agri-Hub" style="-fx-text-fill: #22c55e; -fx-font-size: 34px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(34,197,94,0.4), 12, 0.3, 0, 0);" />
            <Label text="Agricultural Intelligence Hub" style="-fx-text-fill: #8b949e; -fx-font-size: 13px;" />
        </VBox>

        <!-- Divider line -->
        <Region style="-fx-background-color: #22c55e30; -fx-pref-height: 1; -fx-min-height: 1; -fx-max-height: 1; -fx-pref-width: 240; -fx-max-width: 240;" />

        <!-- Feature bullets -->
        <VBox spacing="16" alignment="CENTER_LEFT">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="🤖" style="-fx-font-size: 20px;" />
                <VBox spacing="2">
                    <Label text="AI-Powered Crop Planning" style="-fx-text-fill: #e6edf3; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <Label text="Gemini AI analyses your soil and season" style="-fx-text-fill: #484f58; -fx-font-size: 11px;" />
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="🌾" style="-fx-font-size: 20px;" />
                <VBox spacing="2">
                    <Label text="Disease Identification" style="-fx-text-fill: #e6edf3; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <Label text="Describe symptoms, get expert diagnosis" style="-fx-text-fill: #484f58; -fx-font-size: 11px;" />
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="📈" style="-fx-font-size: 20px;" />
                <VBox spacing="2">
                    <Label text="Yield &amp; Revenue Analytics" style="-fx-text-fill: #e6edf3; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <Label text="Estimate profit before you plant" style="-fx-text-fill: #484f58; -fx-font-size: 11px;" />
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="🌤️" style="-fx-font-size: 20px;" />
                <VBox spacing="2">
                    <Label text="Live Weather Forecasts" style="-fx-text-fill: #e6edf3; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <Label text="Real-time data for your farm location" style="-fx-text-fill: #484f58; -fx-font-size: 11px;" />
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
        <Label text="v2.0 — Powered by Google Gemini AI" style="-fx-text-fill: #30363d; -fx-font-size: 11px;" />
    </VBox>

    <!-- ── RIGHT PANEL: Auth Form ── -->
    <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #0d1117;">

        <VBox styleClass="auth-card" maxWidth="420" alignment="CENTER" spacing="20">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="6">
                <Label text="Welcome back" style="-fx-text-fill: #e6edf3; -fx-font-size: 22px; -fx-font-weight: bold;" />
                <Label text="Sign in to manage your farm" styleClass="text-muted" />
            </VBox>

            <!-- Error Label -->
            <Label
                fx:id="errorLabel"
                styleClass="text-error"
                wrapText="true"
                maxWidth="360"
                alignment="CENTER" />

            <!-- Tabs -->
            <TabPane
                styleClass="auth-tabs"
                tabClosingPolicy="UNAVAILABLE"
                VBox.vgrow="ALWAYS">

                <!-- LOGIN TAB -->
                <Tab text="Sign In">
                    <content>
                        <VBox alignment="CENTER" spacing="14">
                            <padding>
                                <Insets top="24" right="0" bottom="8" left="0" />
                            </padding>
                            <TextField
                                fx:id="loginEmailField"
                                styleClass="field-input"
                                promptText="Email address"
                                maxWidth="360" />
                            <PasswordField
                                fx:id="loginPasswordField"
                                styleClass="field-password"
                                promptText="Password"
                                maxWidth="360" />
                            <Button
                                fx:id="loginBtn"
                                styleClass="btn-primary"
                                text="Sign In"
                                maxWidth="360"
                                onAction="#handleLogin"
                                defaultButton="true"
                                mnemonicParsing="false" />
                        </VBox>
                    </content>
                </Tab>

                <!-- REGISTER TAB -->
                <Tab text="Create Account">
                    <content>
                        <VBox alignment="CENTER" spacing="14">
                            <padding>
                                <Insets top="24" right="0" bottom="8" left="0" />
                            </padding>
                            <TextField
                                fx:id="regEmailField"
                                styleClass="field-input"
                                promptText="Email address"
                                maxWidth="360" />
                            <PasswordField
                                fx:id="regPasswordField"
                                styleClass="field-password"
                                promptText="Create password (min 6 chars)"
                                maxWidth="360" />
                            <Button
                                fx:id="regBtn"
                                styleClass="btn-primary"
                                text="Create Account"
                                maxWidth="360"
                                onAction="#handleRegister"
                                mnemonicParsing="false" />
                        </VBox>
                    </content>
                </Tab>

            </TabPane>

            <Label text="Agricultural Intelligence Hub v2.0" styleClass="text-small" />

        </VBox>

    </StackPane>

</HBox>
